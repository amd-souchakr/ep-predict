# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Large replay-only research data. Derived evidence under artifacts/ is
# intentionally tracked in Git; only inference traces and captured
# hidden/feature tensors are disposable.
artifacts/runs/*/trace/
artifacts/runs/*/features/
artifacts/runs/*/hidden_states/
artifacts/runs/*/activations/

# Model caches remain local.
.cache/
